# Content Factory — Cloud Run Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
#
# NON-SECRET values only — set directly as Cloud Run env vars.
# SECRET values are injected via --set-secrets in deploy-content-factory.sh:
#   GEMINI_API_KEY     → factory-gemini-api-key (Secret Manager)
#   FACTORY_SYNC_SECRET → factory-sync-secret   (Secret Manager)
#   JWT_SECRET         → gg-cms-jwt-secret      (Secret Manager, shared with gg-cms)
#
# ── GG-CMS Target ────────────────────────────────────────────────────────────
GGCMS_BASE_URL=https://gg-cms-backend-274495931884.us-central1.run.app

# ── AI Models ─────────────────────────────────────────────────────────────────
# Use gemini-2.0-flash for all roles — free tier friendly, fast
GEMINI_MODEL_PLANNER=gemini-2.0-flash
GEMINI_MODEL_RESEARCHER=gemini-2.0-flash
GEMINI_MODEL_WRITER=gemini-2.0-flash
GEMINI_MODEL_REVIEWER=gemini-2.0-flash

# ── Runtime ───────────────────────────────────────────────────────────────────
MOCK_MODE=false
LOG_LEVEL=info
DATA_DIR=/app/data

# ── Google Drive ──────────────────────────────────────────────────────────────
# Enable Drive integration — folder ID is configured via the UI at runtime
GDRIVE_ENABLED=true
# GDRIVE_SA_KEY → factory-gdrive-sa-key (Secret Manager, set when SA key is available)

# ── Budget Guardrails ─────────────────────────────────────────────────────────
MAX_MONTHLY_AI_BUDGET=50.00
MAX_COST_PER_CONTENT_UNIT=0.25
MAX_REVISIONS=3
SOURCE_MAX_PAGES=20
SOURCE_MAX_DEPTH=2
WEB_SEARCH_MAX_RESULTS=5
