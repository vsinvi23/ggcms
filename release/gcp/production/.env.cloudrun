# GG-CMS — Production Cloud Run Environment Variables Template
#
# NON-SECRET values: set directly as Cloud Run env vars.
# SECRET values: store in Secret Manager, reference with --set-secrets.

# ── Server ────────────────────────────────────────────────────────────────────
GIN_MODE=release
TLS_ENABLED=false
LOG_LEVEL=info

# ── Databases — use e2-micro INTERNAL VPC IP ──────────────────────────────────
# Connection strings populated dynamically in deploy.sh using Secret Manager:
# DB_WRITE_URL=postgres://gg_cms_user:POSTGRES_PASSWORD@10.xxx.xxx.xxx:5432/gg_cms?sslmode=require
# MONGO_URI=mongodb://gg_cms_user:MONGO_PASSWORD@10.xxx.xxx.xxx:27017/?authSource=admin&tls=true&tlsInsecure=true
MONGO_DATABASE=gg_cms

# ── Admin accounts ────────────────────────────────────────────────────────────
ADMIN_EMAIL=info@serenyax.com
ADMIN_NAME=Super Admin
# ADMIN_PASSWORD injected from Secret Manager: gg-cms-admin-password

# ── Content Factory Sync ─────────────────────────────────────────────────────
CONTENT_FACTORY_URL=https://content-factory-backend-wuisbddlxq-uc.a.run.app
# FACTORY_SYNC_SECRET injected from Secret Manager: factory-sync-secret

# ── Frontend & CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://geekgully.com
CORS_ALLOWED_ORIGINS=https://geekgully.com,http://localhost:8085

# ── Token lifetime ────────────────────────────────────────────────────────────
JWT_EXPIRY_HOURS=24
