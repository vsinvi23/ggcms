# GG-CMS — Test/Staging Cloud Run Environment Variables Template

# ── Server ────────────────────────────────────────────────────────────────────
GIN_MODE=debug
TLS_ENABLED=false
LOG_LEVEL=debug

# ── Databases — Test Database Configuration ──────────────────────────────────
MONGO_DATABASE=gg_cms_test

# ── Admin Accounts ────────────────────────────────────────────────────────────
ADMIN_EMAIL=testadmin@serenyax.com
ADMIN_NAME=Test Admin

# ── Content Factory Sync ─────────────────────────────────────────────────────
# URL of test content factory instance
CONTENT_FACTORY_URL=https://content-factory-backend-test-wuisbddlxq-uc.a.run.app

# ── Frontend & CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://localhost:8085,http://localhost:3000

# ── Token lifetime ────────────────────────────────────────────────────────────
JWT_EXPIRY_HOURS=12
