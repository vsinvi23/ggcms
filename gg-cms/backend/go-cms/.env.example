# Copy to .env and fill in. Never commit .env; secrets below are placeholders.

# Server
SERVER_PORT=8080
GIN_MODE=debug
# APP_ENV=production enables production-only guards (Secure cookies, rate-limit bypass refused).
APP_ENV=development
# LOG_LEVEL controls verbosity: debug | info | warn | error
# debug logs every SQL query; request/response bodies are logged only outside release mode
# and never for /api/auth/*, /api/admin/* or ingest.
LOG_LEVEL=info
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted. Empty trusts none.
TRUSTED_PROXIES=

# PostgreSQL (Write/Primary)
# Docker Compose uses the credentials from your .env (never commit real ones).
DB_WRITE_URL=postgres://gg_cms_user:CHANGE_ME@localhost:5433/gg_cms?sslmode=disable

# PostgreSQL (Read Replica - optional, falls back to write DB if not set)
DB_READ_URL=

# Connection pool limits, applied to EACH of the write and read pools.
# Keep: instances x (write + read pool size) < Postgres max_connections.
# When DB_READ_URL is empty both pools hit the same server, so budget for both.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# MongoDB
MONGO_URI=mongodb://gg_cms_user:CHANGE_ME@localhost:27017
MONGO_DATABASE=gg_cms

# JWT (access token in an HttpOnly cookie + rotating refresh token)
# JWT_SECRET must be at least 32 bytes; the server refuses to start otherwise.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ISSUER=gg-cms
JWT_AUDIENCE=gg-cms-web
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Secure flag on auth cookies (forced on when APP_ENV=production). Set false only for plain-HTTP local dev.
COOKIE_SECURE=true
COOKIE_DOMAIN=
# Reject passwords found in the HaveIBeenPwned k-anonymity range API.
PASSWORD_HIBP_ENABLED=false

# File Upload
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Local dev/test helpers (ignored when APP_ENV=production)
# Set BYPASS_RATE_LIMIT=1 to skip auth rate limiting during local e2e/troubleshooting runs.
BYPASS_RATE_LIMIT=

# Master admin - created automatically on startup if not already in DB.
# Set a strong ADMIN_PASSWORD before first run; the password is applied on next restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
GEEK_ADMIN_EMAIL=
GEEK_ADMIN_NAME=Geek Admin
GEEK_ADMIN_PASSWORD=

# --- Social Login (OAuth2) --------------------------------------------------
# Frontend URL - where the backend redirects after OAuth callback and the base for email links
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (used in email unsubscribe links)
APP_BASE_URL=http://localhost:8080

# Google OAuth - https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorised redirect URI configured in the Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# GitHub OAuth - https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the Authorization callback URL configured in the GitHub OAuth App
GITHUB_REDIRECT_URL=http://localhost:8080/api/auth/github/callback

# LinkedIn OAuth - https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:8080/api/auth/linkedin/callback

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
EMAIL_WORKER_ENABLED=true
EMAIL_MAX_ATTEMPTS=6
DIGEST_ENABLED=true

# --- Content Factory Sync ---------------------------------------------------
# Shared secret the Python "content factory" app sends in the
# X-Factory-Sync-Secret header when POSTing generated content to
# POST /api/import/ingest. Required for that endpoint to accept requests -
# if unset, /api/import/ingest rejects every request with 401 (rest of the
# app still runs fine for local dev).
FACTORY_SYNC_SECRET=

# --- /factory reverse proxy (admin console for the content factory) ---------
# The proxy only admits admin sessions (cookie + CSRF), strips the user's cookies and
# CSRF header, and injects a 60-second HS256 service token (iss=gg-cms-factory-proxy,
# aud=content-factory) signed with FACTORY_PROXY_SECRET. The content-factory verifies it
# with the same FACTORY_PROXY_SECRET; it never sees the user's JWT or JWT_SECRET.
# Both must be set (secret >= 32 bytes) or /factory is not mounted.
CONTENT_FACTORY_URL=
FACTORY_PROXY_SECRET=

# Break-glass admin recovery secret (random, 32+ bytes). Leave empty to disable.
ADMIN_RECOVERY_SECRET=
# Comma-separated CIDRs/IPs allowed to call recover-password (checked before the secret).
# Empty allows any address. Every denied/successful call is audited and logged at WARN.
RECOVERY_ALLOWED_CIDRS=

# --- Login lockout (in-memory, per instance) --------------------------------
# Exponential backoff after repeated failures: per account+IP at LOGIN_LOCK_THRESHOLD,
# per account across all IPs at LOGIN_LOCK_ACCOUNT_THRESHOLD. Lock = base * 2^(extra failures), capped.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_ACCOUNT_THRESHOLD=20
LOGIN_LOCK_BASE_SECONDS=30
LOGIN_LOCK_MAX_MINUTES=15
# REDIS_URL is reserved for a shared rate limiter / lockout store (middleware.RateLimiter
# interface); no Redis client is bundled yet, so limits stay per instance.
REDIS_URL=

# --- AI layer (disabled by default; toggle via PUT /api/ai/settings) --------
# Anthropic API key. Read from the environment only; never stored in the DB or logged.
# Without it every AI endpoint answers 503 AI_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
# Extra hosts (comma separated) AI output may link to; others are stripped. geekgully.com and FRONTEND_URL are always allowed.
AI_ALLOWED_LINK_HOSTS=

# --- Analytics, consent and retention ---------------------------------------
# Secret salt used to hash visitor IPs. Unset = random per-process salt (hashes reset on restart).
ANALYTICS_IP_SALT=
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_ROLLUP_RETENTION_DAYS=730
ANALYTICS_QUEUE_SIZE=5000
ANALYTICS_ROLLUP_ENABLED=true
CONSENT_POLICY_VERSION=2026-01
RETENTION_EMAIL_QUEUE_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=180

# --- Metrics ----------------------------------------------------------------
# Internal listener for /metrics (no auth) and/or a bearer token for /metrics on the main listener.
METRICS_ADDR=
METRICS_TOKEN=

# --- TLS (optional) ---------------------------------------------------------
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=
TLS_CLIENT_CERT_FILE=
TLS_CLIENT_KEY_FILE=

# --- Analytics / notifications / privacy / observability ---
ANALYTICS_IP_SALT=
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_ROLLUP_RETENTION_DAYS=730
ANALYTICS_QUEUE_SIZE=5000
ANALYTICS_ROLLUP_ENABLED=true
APP_BASE_URL=http://localhost:8080
EMAIL_WORKER_ENABLED=true
EMAIL_MAX_ATTEMPTS=6
DIGEST_ENABLED=true
RETENTION_EMAIL_QUEUE_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=180
CONSENT_POLICY_VERSION=2026-01
METRICS_ADDR=
METRICS_TOKEN=

# Search / SEO / lesson gating
PUBLIC_SITE_URL=https://geekgully.com
PUBLIC_LESSON_PREVIEW=first
